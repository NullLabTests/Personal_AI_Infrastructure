#!/usr/bin/env bash
set -euo pipefail

FORGEOS_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_DIR="$FORGEOS_DIR/LIFE-OS-VAULT"
PULSE_DIR="${HOME}/.claude/PAI/PULSE"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

check_cmd() {
  command -v "$1" &>/dev/null || test -f "$HOME/.bun/bin/$1" || test -f "/usr/local/bin/$1"
}
ensure_path() { export PATH="$HOME/.bun/bin:/usr/local/bin:$PATH"; }
ensure_path

header()  { echo -e "\n${CYAN}${BOLD}═══ $1 ═══${NC}"; }
sub()     { echo -e "  ${CYAN}->${NC} $1"; }
ok()      { echo -e "  ${GREEN}*${NC} $1"; }
warn()    { echo -e "  ${YELLOW}!${NC} $1"; }
fail()    { echo -e "  ${RED}x${NC} $1"; }

show_logo() {
  echo -e "${CYAN}"
  echo '       ______                   _____  _____'
  echo '      / ____/___  ____  ____   / __ \/ ___/'
  echo '     / /_  / __ \/ __ \/ __ \/ / / /\__ \ '
  echo '    / __/ / /_/ / /_/ / /_/ / /_/ /___/ / '
  echo '   /_/    \____/\____/\____/\____//____/  '
  echo -e "${NC}"
}

case "${1:-status}" in
  -h|--help|help)
    show_logo
    echo -e "${BOLD}USAGE${NC}"
    echo "  ./forgeos <command>"
    echo ""
    echo -e "${BOLD}COMMANDS${NC}"
    echo "  status        Show system health overview"
    echo "  start         Start Ollama + Pulse dashboard"
    echo "  stop          Stop Pulse dashboard"
    echo "  restart       Restart all services"
    echo "  report [date] Generate Daily Systems Report"
    echo "  chat          Open Ollama WebUI in browser"
    echo "  setup         Run full bootstrap installer"
    echo "  version       Show version"
    ;;

  version)
    echo "ForgeOS v1.0.0"
    ;;

  status)
    show_logo
    header "ForgeOS - System Status"
    sub "Vault:  $VAULT_DIR"
    sub "Repo:   $(git config --get remote.origin.url 2>/dev/null || echo 'not set')"

    header "Ollama"
    if check_cmd ollama; then
      if curl -s --max-time 3 http://localhost:11434/api/tags &>/dev/null; then
        ok "Ollama running on port 11434"
        ollama list 2>/dev/null | tail -n +2 | awk '{print "    " $1 " (" $3 ")"}'
      else
        warn "Ollama installed but not running"
      fi
    else
      fail "Ollama not installed"
    fi

    header "PAI Pulse Dashboard"
    if curl -s --max-time 3 http://localhost:31337/healthz &>/dev/null; then
      ok "Pulse running at http://localhost:31337"
    else
      if check_cmd bun; then
        warn "Bun installed but Pulse not running"
      else
        fail "Bun not installed - run: curl -fsSL https://bun.sh/install | bash"
      fi
    fi

    header "Bun"
    if check_cmd bun; then
      ok "Bun $(bun --version 2>/dev/null || echo '?')"
    else
      fail "Bun not installed"
    fi

    header "Obsidian Vault"
    if [ -d "$VAULT_DIR" ]; then
      ok "Vault at $VAULT_DIR"
      reports=$(ls "$VAULT_DIR"/01_Cognition/Daily-Systems-Report-*.md 2>/dev/null | wc -l)
      echo "    Reports: $reports"
    fi
    ;;

  start)
    show_logo
    header "Starting ForgeOS"

    if ! check_cmd ollama; then
      fail "Ollama not installed - run: curl -fsSL https://ollama.com/install.sh | sh"
      exit 1
    fi

    if ! curl -s --max-time 3 http://localhost:11434/api/tags &>/dev/null; then
      sub "Starting Ollama..."
      ollama serve &>/tmp/ollama.log &
      sleep 4
      if curl -s --max-time 3 http://localhost:11434/api/tags &>/dev/null; then
        ok "Ollama started"
      else
        fail "Ollama failed to start - check /tmp/ollama.log"
        exit 1
      fi
    else
      ok "Ollama already running"
    fi

    for model in deepseek-r1:1.5b nomic-embed-text; do
      if ! ollama list 2>/dev/null | grep -q "$model"; then
        sub "Pulling $model ..."
        ollama pull "$model" 2>/dev/null
        ok "$model ready"
      fi
    done

    if [ ! -f "$PULSE_DIR/pulse.ts" ]; then
      sub "Configuring Pulse for first time..."
      mkdir -p "$PULSE_DIR"
      cp -r "$FORGEOS_DIR/Releases/v5.0.0/.claude/PAI/PULSE/"* "$PULSE_DIR/" 2>/dev/null || true
      if [ -f "$PULSE_DIR/Observability/package.json" ]; then
        cd "$PULSE_DIR/Observability" && bun install &>/dev/null && cd "$FORGEOS_DIR"
      fi
    fi

    if check_cmd bun; then
      if curl -s --max-time 3 http://localhost:31337/healthz &>/dev/null; then
        ok "Pulse already running at http://localhost:31337"
      elif [ -f "$PULSE_DIR/pulse.ts" ]; then
        sub "Starting PAI Pulse..."
        cd "$PULSE_DIR" && bun run pulse.ts &>/tmp/pulse.log &
        sleep 5
        if curl -s --max-time 3 http://localhost:31337/healthz &>/dev/null; then
          ok "Pulse started at http://localhost:31337"
        else
          warn "Pulse may not have started - check /tmp/pulse.log"
        fi
      else
        warn "Pulse not configured. Run: ./setup.sh first"
      fi
    else
      warn "Bun not installed - Pulse dashboard unavailable"
    fi

    header "ForgeOS is Live"
    echo -e "  ${CYAN}http://localhost:31337${NC}   - PAI Pulse Dashboard"
    echo -e "  ${CYAN}http://localhost:11434${NC}   - Ollama API"
    ;;

  stop)
    header "Stopping ForgeOS"
    if pgrep -f "bun.*pulse" &>/dev/null; then
      pkill -f "bun.*pulse" 2>/dev/null
      ok "Pulse stopped"
    else
      warn "Pulse not running"
    fi
    ;;

  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;

  report|daily)
    DATE="${2:-$(date +%Y-%m-%d)}"
    FILE="$VAULT_DIR/01_Cognition/Daily-Systems-Report-$DATE.md"
    YEAR="${DATE%%-*}"
    if [ -f "$FILE" ]; then
      warn "Report for $DATE already exists: $FILE"
      exit 0
    fi
    mkdir -p "$VAULT_DIR/01_Cognition"
    cat > "$FILE" <<REPORT
---
tags: [daily-report, cognition, $YEAR]
date: $DATE
---

# Daily Systems Report - $DATE

## Wins
- [ ] What went well today?

## Blockers
- [ ] What is in the way?

## Next Actions
- [ ] Most important thing to do next

## Body Notes
- Sleep: / Exercise: / Nutrition:

## Capital Notes
- Income: / Expenses: / Net worth change:

## Relationship Notes
- Who did I connect with?

## Impact Notes
- What did I move forward today?
REPORT
    ok "Created $FILE"
    ;;

  chat|webui)
    WEBUI="$VAULT_DIR/Tools/ollama-webui.html"
    if [ -f "$WEBUI" ]; then
      if command -v xdg-open &>/dev/null; then
        xdg-open "$WEBUI" 2>/dev/null || true
      elif command -v open &>/dev/null; then
        open "$WEBUI" 2>/dev/null || true
      fi
      echo "Open this file in your browser:"
      echo "  file://$WEBUI"
    else
      warn "WebUI not found at $WEBUI"
    fi
    ;;

  setup)
    "$FORGEOS_DIR/setup.sh"
    ;;

  *)
    echo "ForgeOS CLI - try: ./forgeos help"
    ;;
esac
